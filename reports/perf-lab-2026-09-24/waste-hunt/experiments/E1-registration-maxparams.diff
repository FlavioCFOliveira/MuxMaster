+// countPatternParams returns the number of wildcard tokens (:name, *name,
+// {name:expr}) in a registration pattern ([waste-hunt E1]).
+func countPatternParams(p string) int {
+	n := 0
+	for {
+		wc, i, _ := findWildcard(p)
+		if i < 0 {
+			return n
+		}
+		n++
+		p = p[i+max(len(wc), 1):]
+	}
+}
