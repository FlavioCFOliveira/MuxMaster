+// allowTable holds the Allow header value for every set of registered
+// methods, indexed by a bitmask over methodNames positions ([waste-hunt E2]).
+// Built once at init: allowed() then returns a constant string instead of
+// rebuilding it with a strings.Builder on every 405 / auto-OPTIONS request.
+var allowTable = func() (t [1 << methodCount]string) {
+	for mask := 1; mask < len(t); mask++ {
+		if mask&(1<<idxOPTIONS) != 0 || mask&(1<<idxWild) != 0 {
+			continue // never produced by allowed()
+		}
+		var b strings.Builder
+		for i := range methodCount {
+			if mask&(1<<i) != 0 {
+				if b.Len() > 0 {
+					b.WriteString(", ")
+				}
+				b.WriteString(methodNames[i])
+			}
+		}
+		b.WriteString(", ")
+		b.WriteString(http.MethodOptions)
+		t[mask] = b.String()
+	}
+	return t
+}()
