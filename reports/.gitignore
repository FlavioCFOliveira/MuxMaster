# Evidências brutas e artefactos pesados — não versionados
evidence/
*/evidence/

# Profiles e traces
*.pprof
*.prof
*.trace
*.out

# SARIF pode ser grande; versionar apenas se < 1MB
# Descomentar se quiseres manter SARIF no git:
# !*.sarif

# Outputs binários de fuzz / crashers
*/harness/testdata/fuzz/*/crashers/
*.crash

# CSVs grandes de timing (raw samples)
*_raw.csv
*/evidence/*.csv

# Imagens / plots gerados
*.png
*.svg
# Mas deixar architecture/ e docs/ diagrams intocados se forem usados:
# !docs/**/*.png

# Go build artefacts
*.test
*.bench
